# ---------------------------------------------------------------------------
# Gmail MCP — copy to .env and fill in. .env is gitignored; never commit it.
#
# Gmail has no service-account model for a personal inbox, so this needs a
# real OAuth 2.0 client and a one-time browser consent. If you don't have
# GMAIL_REFRESH_TOKEN yet, see the README's "Authentication" section, then run:
#
#   ./.venv/bin/gmail-mcp-authorize
#
# which will print all three GMAIL_* values below for you.
# ---------------------------------------------------------------------------

# From your OAuth 2.0 "Desktop app" client in Google Cloud Console
# (APIs & Services -> Credentials).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Produced once by gmail-mcp-authorize. Long-lived until you revoke it at
# https://myaccount.google.com/permissions.
GMAIL_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# ACCESS LEVEL — controls what this server will actually do, independent of
# what the OAuth consent above technically permits (that consent always grants
# the FULL ceiling, precisely so raising this later needs no re-consent).
#
#   READONLY  (default)  List, search, and read messages/threads. 5 tools.
#   BASIC                + create/edit/delete drafts. Never sends. 10 tools.
#   FULL                 + send mail as you, label, archive, trash. 15 tools.
#
# Tools above the configured level are never registered, so the AI model is
# not even shown that they exist.
#
# !! FULL lets an AI model send email from your account with no human click in
# !! between, and modify or trash existing messages. Sending cannot be undone.
# !! See the README's "Access Levels" section before raising this.
# ---------------------------------------------------------------------------
GMAIL_ACCESS_LEVEL=READONLY

# Optional. Default page size for search_messages/list_drafts when not given.
# GMAIL_DEFAULT_MAX_RESULTS=25

# Optional. Per-request timeout in seconds.
# GMAIL_TIMEOUT=30
