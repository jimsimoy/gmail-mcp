# Credentials — never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
token.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.python-version
uv.lock

# Local deny-list for the pre-push scan. Holds names that must never appear in
# this repo — and would itself be a leak if committed.
.git-deny-patterns

# Tooling / OS
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.DS_Store
.idea/
.vscode/
